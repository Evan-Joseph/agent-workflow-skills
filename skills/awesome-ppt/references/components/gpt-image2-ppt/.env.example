# OpenAI official Images API (or any OpenAI-compatible relay you trust)
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=sk-your-key-here

# GRSAI direct draw API example:
# OPENAI_BASE_URL=https://grsai.dakka.com.cn
# GRSAI_API_KEY=sk-your-grsai-key-here
# OPENAI_API_KEY=sk-your-grsai-key-here  # optional compatibility fallback
# GPT_IMAGE_ENDPOINT=grsai

# Model name (default: gpt-image-2)
GPT_IMAGE_MODEL_NAME=gpt-image-2

# Image quality: low / medium / high / auto
GPT_IMAGE_QUALITY=high

# Endpoint mode: auto / images / chat / grsai
GPT_IMAGE_ENDPOINT=auto

# -- Vision provider (OPTIONAL: defaults to local MagPie :3425 group/carbon) --
# Template-clone mode defaults to ${OPENAI_COMPAT_BASE_URL} (model=group/carbon)
# reading credentials from ~/.agents/config/magpie-ops-probe.json when unset.
# Override below only when pointing to an explicit custom endpoint:
#   VISION_BASE_URL=${OPENAI_COMPAT_BASE_URL}
#   VISION_API_KEY=magpie-awesome-ppt
#   VISION_MODEL_NAME=group/carbon
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL_NAME=
